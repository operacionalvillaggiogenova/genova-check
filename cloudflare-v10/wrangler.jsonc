{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genova-check",
  "main": "src/v11-worker.mjs",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "../public/legacy",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blexo-suite",
      "database_id": "8bdb42e8-0a0b-4b13-a416-de3ff283be25",
      "migrations_dir": "src/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "blexo-check-evidence"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
